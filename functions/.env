# すべてのプロジェクトに共通の設定
#
# プロジェクトごとに変えたい値は .env.<プロジェクト ID> に書く（そちらが優先される）。
#
# **秘密情報は書かないこと。** このファイルはリポジトリに入っている。
# 鍵やトークンは Secret Manager（firebase functions:secrets:set）を使う。
#
# ---
#
# ここに書いておかないと、デプロイのたびに値の入力を求められる。
# defineString の default は「入力を求めるときの初期値」であって、
# 入力を省く指定ではないため。しかも答えた内容は
# .env.<プロジェクト ID> に**書き込まれる**ので、リポジトリのファイルが
# 勝手に書き換わってしまう。それを避けるために明示しておく。

# Cloud Functions を動かすリージョン（既定は東京）。
FUNCTIONS_REGION=asia-northeast1

# Storage のトリガーを動かすリージョン。
# バケットと同じリージョンでなければデプロイできない。
STORAGE_REGION=asia-northeast1
