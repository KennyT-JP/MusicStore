{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "//": "フォント・画像・CanvasKit などのファイル名が変わらない静的資産。1 年キャッシュし、再訪問時は取得し直さない。",
        "source": "**/*.@(ttf|otf|woff|woff2|png|jpg|jpeg|gif|svg|webp|wasm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "//": "index.html と Service Worker は毎回確認させる。ここをキャッシュすると、更新しても古い版が表示され続ける。",
        "source": "/@(index.html|flutter_service_worker.js|flutter_bootstrap.js|version.json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "//": "main.dart.js などのビルド成果物。内容が変わればファイルも作り直されるが、名前は同じなので短めにして更新を取りこぼさないようにする。",
        "source": "**/*.@(js|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099,
      "host": "127.0.0.1"
    },
    "firestore": {
      "port": 8080,
      "host": "127.0.0.1"
    },
    "storage": {
      "port": 9199,
      "host": "127.0.0.1"
    },
    "functions": {
      "port": 5001,
      "host": "127.0.0.1"
    },
    "//pubsub": "定期実行（purgeDeletedFiles）は pubsub エミュレータが無いと読み込み時に無視され、エミュレータ上で一度も起動できない。ログには function ignored because the pubsub emulator does not exist としか出ないため気づきにくい（監査 第2回）。",
    "pubsub": {
      "port": 8085,
      "host": "127.0.0.1"
    },
    "ui": {
      "enabled": true,
      "port": 4000,
      "host": "127.0.0.1"
    },
    "singleProjectMode": true,
    "//host": "localhost が IPv6(::1) に解決される環境で、エミュレータ間の通信が失敗することがあるため、待ち受けアドレスを明示している。"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "//predeploy": "Firebase の例では $RESOURCE_DIR を使うが、Windows のコマンドプロンプトでは展開されずに失敗する。predeploy はプロジェクトのルートで実行されるので、相対パスで書けばどの OS でも動く。",
      "predeploy": [
        "npm --prefix functions run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        "test"
      ]
    }
  ]
}
