<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>音源創庫</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Track Cabinet</string>
	<!-- **これが無いと、日本語の端末でも英語で起動する。** iOS は
	     `preferredLanguages` を「アプリが対応している言語」で絞ってから
	     Flutter へ渡すので、未記載だと開発言語（en）しか候補に残らない。
	     **Flutter 側の `supportedLocales`（lib/l10n/app_localizations.dart）は
	     OS の判断に効かない。** Android では起きない形の落とし穴。
	     `l10n.yaml`（arb-dir: lib/l10n）の言語と揃えること——
	     いまは `app_ja.arb` / `app_en.arb` の 2 つ。
	     test/domain/ios_platform_config_test.dart が突き合わせている。 -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>ja</string>
		<string>en</string>
	</array>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- **輸出コンプライアンスの質問を毎回出さないため。** 独自の暗号は
	     持たず、HTTPS しか使っていないので false でよい。書かないと
	     App Store Connect が**アップロードのたびに**同じ質問を出す
	     （設計 5-7・5-17：これを入れてあるので提出物としては「不要」扱い）。 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- ##### ここから 2 つは、まだ本物の値が入っていない #####

	     Google ログインの戻り先。**Google のサインイン画面から戻ってこられる
	     のは、この URL Scheme が登録されているときだけ**——無いと、認証は
	     済んでいるのにアプリへ制御が返らず、利用者からは「固まった」ように
	     見える（設計 5-5 / 5-7）。

	     **値は `ios/Runner/GoogleService-Info.plist` の `REVERSED_CLIENT_ID` と
	     一字一句同じでなければならないが、そのファイルがまだ無い**
	     （Firebase の iOS 設定は未生成。設計 5-3 の
	     `scripts\configure-firebase.cmd --platforms=web,android,ios` で作る）。

	     **いまの値は `REPLACE_ME` を挟んだプレースホルダで、このままでは
	     Google ログインは戻ってこない。** `REPLACE_ME` は、この
	     リポジトリが「未設定」を表すのに使っている印
	     （`scripts/deploy.mjs` が Web の接続設定で同じ印を見張っている）。
	     **`GoogleService-Info.plist` を置いたら、この 2 つを実値に差し替える
	     こと。片方だけ直しても戻れない。** -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.REPLACE_ME</string>
			</array>
		</dict>
	</array>
	<!-- `google_sign_in` が読む iOS 用のクライアント ID。
	     `GoogleService-Info.plist` の `CLIENT_ID` と同じ値にする。
	     **上と同じくプレースホルダ。実値に差し替えること。** -->
	<key>GIDClientID</key>
	<string>REPLACE_ME.apps.googleusercontent.com</string>
	<!-- ##### プレースホルダはここまで #####

	     **意図的に書いていないもの**（設計 5-7・7 節）。
	     「念のため書いておく」がいちばん悪い選択なので、消さないこと。

	     - `UIBackgroundModes`
	       使わない背景動作を宣言したまま出すと、審査で用途の説明を
	       求められる。**バックグラウンド再生は今回やらない**（7 節）。
	       通知も今回やらない（`remote-notification` も書かない）。
	     - `NSCameraUsageDescription`
	       カメラを使わない。使わない権限を書くと審査で用途を訊かれる。
	     - `NSPhotoLibraryUsageDescription`
	       写真を選ばない。`file_picker` は UIDocumentPicker を使うので
	       権限宣言が要らない**はず**——**社内に前例が無い**（9 節）ので、
	       実機で確かめるまで断定しない。要ると分かってから足すこと。
	     - `NSMicrophoneUsageDescription` / `NSUserTrackingUsageDescription` /
	       `NSAppTransportSecurity` / `LSApplicationQueriesSchemes`
	       いずれも使っていない。広告 SDK を同梱していないので ATT も不要。 -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
