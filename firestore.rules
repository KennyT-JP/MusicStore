rules_version = '2';

// Firestore セキュリティルール（仕様書 13.5）
//
// 画面上の出し分け（14.5）は利便性のためのもので、権限の担保はここで行う。
// 12.6 のとおり、このファイルは Firebase Emulator Suite でテストする。
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------
    // ヘルパー
    // -----------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // メール確認が済んでいること（3.1）。
    //
    // **画面のリダイレクトだけでは守れない。** 直接 API を叩けば通ってしまう。
    // 「確認が済むまでアプリは使えない」を実際に担保するのはここ（監査 S3）。
    // Google 連携で入った場合、このクレームは最初から true になる。
    //
    // 以降、users の作成を除くすべての判定はこちらを使う。未確認のうちは
    // 自分のユーザードキュメントを作れるだけで、他は何も読めない・書けない。
    function isVerified() {
      // `.get()` を使うと、コレクショングループの list 評価で
      // 「Null value error」になる場合がある。`in` で存在を確かめてから読む。
      return isSignedIn()
        && 'email_verified' in request.auth.token
        && request.auth.token.email_verified == true;
    }

    // サイト管理者は Auth のカスタムクレームで判定する（13.5）。
    // ルールから追加の読み取りが発生しないため、高速かつ課金もない。
    //
    // クレームが無いユーザーでも評価エラーにならないよう、
    // `in` で存在を確かめてから読む（isVerified と同じ理由）。
    function isSiteAdmin() {
      return isVerified()
        && 'siteAdmin' in request.auth.token
        && request.auth.token.siteAdmin == true;
    }

    function uid() {
      return request.auth.uid;
    }

    // **users/{uid} のうち、サーバーだけが書いてよい項目**
    // （docs/PREMIUM-DESIGN.md 3.1・6 の 5）。
    //
    // - premium: クーポンの引き換えと、管理画面からの延長で Functions が書く
    // - storage: アップロードの後始末で Functions が集計する
    //
    // **ここが開いていると、誰でも自分を無期限のプレミアムにでき、
    // 容量の上限も自分で広げられる。** 作成と更新の両方で塞ぐ——
    // 登録直後の create はまだドキュメントが無いので、更新だけ塞いでも
    // 最初の 1 回で書き込めてしまう。
    //
    // **置き場所を users/{uid}/private/state へ移したあとも、この一覧は残す。**
    // 移した先の話であって、親が開いてよくなったわけではない。残す理由は 2 つ。
    //
    // 1. **移行前の古い行には、まだ premium / storage が残っている。**
    //    ここを開けると、その残骸を本人が書き換えられる。消すのは移行の
    //    仕事で、ルールにできるのは「もう書けない」を保つことだけ。
    // 2. **親へ書き戻せると、分けた意味が消える。** 親は表示名の解決のため
    //    ログイン済みなら誰でも読めるので、そこへ自分で premium を
    //    生やされたら、せっかく移した情報がまた誰にでも見える場所に並ぶ。
    function serverOwnedUserFields() {
      return ['premium', 'storage'];
    }

    function memberPath(listId) {
      return /databases/$(database)/documents/lists/$(listId)/members/$(uid());
    }

    function isMember(listId) {
      return isSiteAdmin() || (isVerified() && exists(memberPath(listId)));
    }

    function memberRole(listId) {
      return get(memberPath(listId)).data.role;
    }

    // **参加せずに見るだけの人（仕様書 3.3）。**
    //
    // 共有リンクを開いて「参加しない」を選ぶと、Functions がここへ書く。
    // メンバーとは別に持っているので、メンバー一覧にも人数にも
    // 通知の宛先にも入らない。**読めるだけで、何も書けない。**
    function viewerPath(listId) {
      return /databases/$(database)/documents/lists/$(listId)/viewers/$(uid());
    }

    function isViewer(listId) {
      return isVerified() && exists(viewerPath(listId));
    }

    /// 中身を見てよい人。メンバーか、閲覧だけの人。
    function canRead(listId) {
      return isMember(listId) || isViewer(listId);
    }

    function isListAdmin(listId) {
      return isSiteAdmin() ||
        (isVerified() &&
         exists(memberPath(listId)) &&
         memberRole(listId) == 'listAdmin');
    }

    // Super User 以上。上位は下位を包含する（4.1）。
    function canWrite(listId) {
      return isListAdmin(listId) ||
        (isVerified() &&
         exists(memberPath(listId)) &&
         memberRole(listId) == 'superUser');
    }

    // -----------------------------------------------------------------
    // コレクショングループのクエリ（13.3）
    //
    // **通常の match だけでは、collectionGroup のクエリは許可されない。**
    // `/lists/{listId}/members/{uid}` に read を書いても、それは
    // そのパスを直接指した取得にしか効かない。横断的に引くには、
    // 再帰ワイルドカードを使った match を別に書く必要がある。
    //
    // これが無かったため、ホームの参加リスト一覧は
    // 「リストを作ってもホームに出ない」状態になっていた。
    //
    // 許すのは**自分の行だけ**。ドキュメント ID が自分の uid のものに限る。
    // -----------------------------------------------------------------

    match /{path=**}/members/{memberUid} {
      // **ドキュメント ID ではなく、中の uid 項目で判定する。**
      // コレクショングループの評価では ID の変数が束縛されないため
      // （Null value error になる）、ドキュメントの中身で見る。
      // クエリ側も uid 項目で絞っているので、返るのは自分の行だけ。
      allow list: if isVerified() && resource.data.uid == uid();
    }

    match /{path=**}/joinRequests/{requesterUid} {
      allow list: if isVerified() && resource.data.uid == uid();
    }

    // -----------------------------------------------------------------
    // users
    // -----------------------------------------------------------------

    match /users/{userId} {
      // 表示名の解決に必要なため、ID 直接指定の取得は許す（13.3）。
      //
      // **自分の行だけは、メール確認が済む前でも読める。**
      // 登録処理は「読んで、無ければ作る」順で動く
      // （lib/data/repositories/auth_repository.dart の _ensureUserDocument）。
      // 読みを許さないと、登録直後の未確認の状態でそこが拒否され、
      // 例外で処理が止まる。その先にある確認メールの送信に到達せず、
      // **メールが届かないまま「エラーが発生しました」とだけ出る**（監査 第2回）。
      //
      // 下の create が isSignedIn なのと対になっている。作れるのに読めない、
      // という食い違いが原因だった。読めるのは自分の行だけなので、
      // 他人の情報が未確認の状態で漏れることはない。
      // **この取得はドキュメント全体を返す。項目を選んで隠せない。**
      // Firestore のルールに項目単位の読み取り制限は無い。だから
      // 「見せてよいものだけを、ここに置く」で解いている。
      //
      //   ここに残るもの : displayName, photoURL, isWithdrawn,
      //                    createdAt, updatedAt
      //   移したもの     : email, locale, notificationSettings,
      //                    premium{...}, storage{...}
      //                    → users/{uid}/private/state（下の match /private）
      //
      // メールアドレスは以前からここで露出しており、プレミアムの期限と
      // 容量の使用量が 2026-08-11 に加わった（BACKLOG「users ドキュメントが、
      // ログイン済みなら誰にでも読める」）。**まとめて移す**——片方だけ直すと
      // 「対処済み」に見えて残りが忘れられる。
      //
      // **移行前の古い行では、まだ見えてしまう。** ルールでは隠せないので、
      // 消すのは移行の側の仕事。ここでできるのは「もう書けない」を保つこと
      // だけ（serverOwnedUserFields）。
      allow get: if isVerified() || (isSignedIn() && uid() == userId);

      // **一覧としての取得は禁じる。** 許すと全会員のメールアドレスと表示名を
      // 一括で収集できてしまう（監査 S2）。表示名の解決は ID 指定の取得を
      // 人数ぶん行う（lib/data/repositories/list_repository.dart の fetchUsers）。
      allow list: if isSiteAdmin();

      // 登録直後はまだメール確認が済んでいないため、ここだけ isSignedIn で許す。
      // 作れるのは自分のドキュメントだけ。
      //
      // **最初の 1 回で premium を仕込めないようにする。** 下の update だけを
      // 塞いでも、まだドキュメントが無い状態なら create が通ってしまう。
      allow create: if isSignedIn() && uid() == userId
        && !request.resource.data.keys().hasAny(serverOwnedUserFields());

      allow update: if isVerified() && uid() == userId
        && !request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasAny(['isWithdrawn', 'withdrawnAt'].concat(serverOwnedUserFields()));

      // 退会しても users ドキュメントは残す（3.5）。削除は許可しない。
      allow delete: if false;

      // ---------------------------------------------------------------
      // private（本人しか見なくてよい情報／13.3）
      //
      //   users/{uid}/private/state
      //     email, locale, notificationSettings,
      //     premium{...}, storage{...}
      //
      // **ドキュメントを分けることが、そのまま守りになっている。**
      // 親の users/{uid} は表示名の解決のため ID 指定で誰でも読めるので、
      // 同じドキュメントに置いた項目は、隠したいものも一緒に降りてくる。
      // 項目単位の読み取り制限は無いのだから、分けるしかない。
      // ---------------------------------------------------------------

      match /private/{docId} {
        // **本人だけ。サイト管理者も読めない。**
        // 管理画面が要る情報はサーバー経由で取る（listSiteUsers など）。
        // Admin SDK はルールを迂回するので、それで足りる。**足りるなら、
        // ここを開ける理由は無い。** 開ければ「管理者の端末が乗っ取られた
        // ときに全員のメールアドレスが降りてくる」経路をわざわざ作ることになる。
        //
        // **メール確認前でも、本人には読ませる。** 登録処理は「読んで、
        // 無ければ作る」順で動く（親の users を isSignedIn で読めるように
        // してあるのと同じ理由／監査 第2回）。ここを isVerified にすると
        // 登録直後の読みが拒否されて例外で止まり、その先の確認メールの
        // 送信に到達しない。**メールが届かないまま「エラーが発生しました」
        // とだけ出る**、あの失敗をもう一度作ることになる。
        allow read: if isSignedIn() && uid() == userId;

        // **中身は「本人のもの」と「サーバーのもの」が混ざっている。**
        // 場所を分けたのは他人に見せないためであって、本人から取り上げる
        // ためではない。表示言語（locale）と通知設定（notificationSettings）は
        // 設定画面で本人が変えるものなので、書かせないと保存が権限拒否になる。
        //
        //   本人が書いてよい : locale, notificationSettings
        //   サーバーだけ     : premium, storage（serverOwnedUserFields）
        //                      email は Auth 側が正本で、Functions が写す
        //
        // **premium / storage をここで許すと、親で塞いだものが子で開く。**
        // 誰でも自分を無期限のプレミアムにでき、容量の上限も自分で広げられる。
        // 親の users/{uid} と同じ書き方（affectedKeys().hasAny）で塞ぐ——
        // **同じ規則は同じ形で書く。** 形が違うと、片方だけ直されて食い違う。
        //
        // **create と update を分けるのは、書き方が違うから。** create の
        // 時点では resource が無く、diff() は使えない。親の users/{uid} が
        // create を keys()、update を diff() で書いているのと同じ理由で、
        // **update だけ塞いでも最初の 1 回で書き込めてしまう。**
        //
        // create も許すのは、**まだドキュメントが無い人がいるため**。
        // 画面側は最初の保存を set(merge: true) で行う（既存の行が無ければ
        // create、あれば update として評価される）。
        //
        // **メール確認前でも書けてよい**（読みと揃える）。登録直後に
        // 表示言語を保存する経路があり、そこで拒否されると設定が消える。
        // 書ける中身は自分の locale と通知設定だけなので、開けても増える
        // 危険が無い。
        //
        // **docId は state に限る。** この下は 1 ドキュメントしか使わない
        // 設計（lib/data/firestore_paths.dart の privateStateDoc、
        // functions/src/config.ts の userPrivate）。限らないと、
        // ログインしただけの人が自分の下へ好きなだけ書類を作れる。
        // lists/{listId}/meta が docId == 'stats' に限っているのと同じ扱い。
        allow create: if isSignedIn() && uid() == userId
          && docId == 'state'
          && !request.resource.data.keys().hasAny(serverOwnedUserFields());

        allow update: if isSignedIn() && uid() == userId
          && docId == 'state'
          && !request.resource.data.diff(resource.data)
               .affectedKeys().hasAny(serverOwnedUserFields());

        // **削除はさせない。** 消せると、サーバーが持っている premium /
        // storage を本人が捨てられる（書けないものを、消す形で書き換えるのと
        // 同じことになる）。明示して書く——「書き忘れて拒否されている」のと
        // 「意図して禁じた」のは、あとから読んで区別が付かない。
        allow delete: if false;

        // **コレクショングループの match は、意図的に書いていない。**
        // 上の /{path=**}/members のような再帰ワイルドカードを足すと、
        // private を横断で引けるようになる。書かないことで閉じている。
        // 足すときは「誰の行が返るか」を uid で縛ること。
      }

      match /notifications/{notificationId} {
        allow read: if isVerified() && uid() == userId;

        // 既読の更新だけを本人に許す。作成は Functions のみ（13.4）。
        allow update: if isVerified() && uid() == userId
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['isRead']);
        allow create, delete: if false;
      }
    }

    // -----------------------------------------------------------------
    // lists（公開可能な最小情報のみ／13.2）
    // -----------------------------------------------------------------

    match /lists/{listId} {
      // 未参加者にもリスト名だけは見せる（5.3）。共有 URL から到達できるように
      // ID 直接指定の取得は許す。使用容量などの内部情報は meta/stats に
      // 分けてあるため、このドキュメント自体は公開してよい。
      allow get: if isVerified();

      // ただし**一覧としての取得は禁じる**。許すと未参加者が全リスト名を
      // 列挙できてしまい、「全リストの一覧を公開する画面は作らない」（5.3）に反する。
      // 全リストを見られるのはサイト管理画面（11.1）だけ。
      allow list: if isSiteAdmin();

      // 作成は承認処理（Functions）のみ（5.1）。
      allow create: if false;

      // **更新は全面禁止**（2026-08-14）。
      //
      // 以前は「集計フィールド以外なら書ける」形だったので、
      // **`name` を API 直で書き換えられた。** ところが名前の一意性は
      // `listNames/{nameLower}` の予約と `nameLower` で守っており
      // （13.3）、`name` だけ変わると**予約と表示名が食い違う**。
      // 同じ名前のリストを 2 つ作れる状態になる。
      //
      // 画面にリスト名を変える導線は無い。**使えない道を開けておく理由が
      // 無い**ので閉じる（監査 第4回で記録に回していた項目）。
      //
      // **リスト名の変更を作るときは、ここではなく Functions で**——
      // 予約の付け替えと `nameLower` の更新を、ひとつのトランザクション
      // でまとめて行う必要がある（承認処理と同じ形）。
      allow update: if false;

      allow delete: if isListAdmin(listId);

      // ---------------------------------------------------------------
      // meta/stats（容量・連番／13.3）
      // ---------------------------------------------------------------

      match /meta/{docId} {
        // 閲覧だけの人にも読ませる。連番の欠番や容量の表示に要る。
        allow read: if canRead(listId);

        // **連番の採番だけはクライアントが行う（6.2）。**
        // 項目の追加と同じトランザクションで nextSeq を 1 進める。
        // ここを禁じていたため、項目の追加が一度も成功しなかった。
        // コメントには「連番はトランザクション」と書きながら、
        // 書き込みを全面禁止していた（文とルールの食い違い）。
        //
        // 許すのは **nextSeq を 1 だけ進めること**に限る。
        // ほかの項目（容量・通知フラグ）は Functions だけが書く。
        // 戻したり飛ばしたりできないので、「振り直さない・欠番は残す」
        // という規則はここで守られる。
        allow update: if docId == 'stats'
          && canWrite(listId)
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['nextSeq'])
          && request.resource.data.nextSeq == resource.data.nextSeq + 1;

        allow create, delete: if false;
      }

      // ---------------------------------------------------------------
      // members
      // ---------------------------------------------------------------

      match /members/{memberUid} {
        // 自分の行は、メンバーかどうかの判定のために本人も読める。
        allow read: if isMember(listId) || (isVerified() && uid() == memberUid);

        // 追加は承認・招待受諾（Functions）のみ。
        allow create: if false;

        allow update: if isListAdmin(listId);

        // 除外はリスト管理者以上、離脱は本人（5.4）。
        allow delete: if isListAdmin(listId) ||
          (isVerified() && uid() == memberUid);
      }

      // ---------------------------------------------------------------
      // joinRequests（参加申請／5.2）
      // ---------------------------------------------------------------

      // ---------------------------------------------------------------
      // viewers（参加せずに見るだけの人／3.3）
      // ---------------------------------------------------------------

      match /viewers/{viewerUid} {
        // 自分の行と、リスト管理者だけが見られる。
        // **誰が見ているかはリスト管理者に分かるようにする。**
        allow read: if isListAdmin(listId) ||
          (isVerified() && uid() == viewerUid);

        // **書けるのは Functions だけ。** クライアントから書けると、
        // リンクを持っていない人が自分で閲覧権を作れてしまう。
        allow create, update: if false;

        // 自分から閲覧をやめることはできる。
        allow delete: if isListAdmin(listId) ||
          (isVerified() && uid() == viewerUid);
      }

      match /joinRequests/{requesterUid} {
        allow read: if isListAdmin(listId) ||
          (isVerified() && uid() == requesterUid);

        // 申請者は役割を選べない（5.2）。pending 以外での作成も認めない。
        // 却下後の再申請は同じドキュメントの上書きで行う（5.2.1）。
        // uid はコレクショングループで引くために持たせる（監査 S14 と同じ制約）。
        // 自分以外の uid は書けない。
        allow create, update: if isVerified()
          && uid() == requesterUid
          && (!('uid' in request.resource.data)
              || request.resource.data.uid == uid())
          && request.resource.data.status == 'pending'
          && !request.resource.data.keys().hasAny(['assignedRole', 'decidedBy']);

        // 承認・却下は Functions が行う。申請の取り下げは本人に許す。
        allow delete: if isListAdmin(listId) ||
          (isVerified() && uid() == requesterUid);
      }

      // ---------------------------------------------------------------
      // items（6 章）
      // ---------------------------------------------------------------

      match /items/{itemId} {
        // **閲覧だけの人も読める（3.3）。** 書くのはメンバーだけ。
        allow read: if canRead(listId);

        // ファイルの保存先が、この項目の場所であること（13.7）。
        //
        // **これを確かめないと、他人のリストのパスを書き込める。**
        // 定期削除がそのパスを消しに行くため、サーバーの権限で
        // 他リストの音源を破壊できてしまう（監査 S1）。
        function fileBelongsHere() {
          return !('file' in request.resource.data)
            || request.resource.data.file == null
            || request.resource.data.file.storagePath is string
               && request.resource.data.file.storagePath
                    .matches('^lists/' + listId + '/items/' + itemId + '/.+');
        }

        // status は 2 値のみ（6.2）。任意の文字列は入れさせない。
        function statusIsValid() {
          return !('status' in request.resource.data)
            || request.resource.data.status in ['active', 'deleted'];
        }

        // previousFiles は差し替え機能のための受け口で、Functions が書く。
        // クライアントからは触らせない（監査 S1）。
        function noPreviousFiles() {
          return !('previousFiles' in request.resource.data)
            || request.resource.data.previousFiles == null;
        }

        // **更新では「変えられない」で守る**（2026-08-14）。
        //
        // 上の形（無いか null）を update にも使うと、**差し替えを 1 度でも
        // 行った項目は、それ以降まったく編集できなくなる。**
        // update の `request.resource.data` は**書き換えた後の全体**なので、
        // Functions が積んだ `previousFiles` がそこに必ず含まれるためである。
        // 曲名を直すだけの保存も拒否される。
        //
        // 守りたいのは「クライアントが previousFiles を書けないこと」なので、
        // **差分に出てこないこと**で表す。
        function previousFilesUnchanged() {
          return !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['previousFiles']);
        }

        // 追加は Super User 以上（4.2）。登録者は自分自身に限る。
        allow create: if canWrite(listId)
          && request.resource.data.createdBy == uid()
          && request.resource.data.seq is int
          && request.resource.data.status == 'active'
          && fileBelongsHere()
          && noPreviousFiles();

        // 編集・削除は本人＋リスト管理者以上（6.3）。
        // 連番は振り直さない（6.2）ので、seq の変更は許可しない。
        //
        // 復元（deleted → active）はリスト管理者以上のみ。猶予期間内かどうかは
        // purgeAt で判定する（6.3）。Dart 側の Permissions.canRestoreItem と
        // 同じ規則をここでも持つ（画面だけの制限にしない／監査 S12）。
        function restoreIsAllowed() {
          return resource.data.status != 'deleted'
            || request.resource.data.status != 'active'
            || (isListAdmin(listId)
                && resource.data.purgeAt is timestamp
                && resource.data.purgeAt > request.time);
        }

        // **purgeAt は「いつ消してよいか」を決める値**で、定期削除の
        // 唯一の判断材料（functions/src/scheduled/purge.ts）。
        // 以前は update で自由に書けたため、**削除したはずのファイルを
        // 永久に残せた**（監査 第4回で記録に回していた項目。実害は
        // 自分のリストの容量を食うことに閉じるが、掃除が効かなくなる）。
        //
        // 決まりは 3 つ。
        //
        //   - 削除するとき（→ deleted）は**未来の時刻**を入れる。
        //     **上限も置く**（400 日）。年 3000 のような値を弾くため。
        //     猶予の既定は 30 日なので、設定を変えても収まる
        //   - 復元するとき（deleted → active）は **null に戻す**
        //   - **それ以外の編集では変えられない**（曲名を直すついでに
        //     猶予を伸ばす、ができないようにする）
        function purgeAtIsValid() {
          let before = resource.data.status;
          let after = request.resource.data.status;
          let purge = request.resource.data.get('purgeAt', null);
          return (after == 'deleted' && before != 'deleted')
            ? (purge is timestamp
                && purge > request.time
                && purge < request.time + duration.value(400, 'd'))
            : ((after == 'active' && before == 'deleted')
                ? purge == null
                : purge == resource.data.get('purgeAt', null));
        }

        allow update: if (isListAdmin(listId) ||
            (canWrite(listId) && resource.data.createdBy == uid()))
          && request.resource.data.seq == resource.data.seq
          && request.resource.data.createdBy == resource.data.createdBy
          && statusIsValid()
          && fileBelongsHere()
          && previousFilesUnchanged()
          && restoreIsAllowed()
          && purgeAtIsValid();

        // 物理削除はしない。status を 'deleted' にするソフト削除（6.2）。
        allow delete: if false;

        match /comments/{commentId} {
          allow read: if canRead(listId);

          // Read Only は一切書けない（9）。
          allow create: if canWrite(listId)
            && request.resource.data.createdBy == uid();

          // 復元（deleted → active）はリスト管理者以上のみ。items の
          // restoreIsAllowed と同じ規則をコメントにも課す（監査 第4回）。
          // これが無いと、リスト管理者が消したコメントを**投稿者本人が
          // active に書き戻して**、削除を無かったことにできる。
          // （コメントに purgeAt は無いので、見るのは status だけ。）
          function commentRestoreIsAllowed() {
            return !('status' in resource.data)
              || resource.data.status != 'deleted'
              || request.resource.data.status != 'active'
              || isListAdmin(listId);
          }

          allow update: if (isListAdmin(listId) ||
              (canWrite(listId) && resource.data.createdBy == uid()))
            && request.resource.data.createdBy == resource.data.createdBy
            && commentRestoreIsAllowed();

          // 返信がぶら下がるためソフト削除にする（9）。
          allow delete: if false;
        }
      }
    }

    // -----------------------------------------------------------------
    // listNames（リスト名の重複チェック／13.3）
    // -----------------------------------------------------------------

    match /listNames/{nameLower} {
      // ID 直接指定でのみ到達させる。list による列挙は許可しない。
      // 列挙できると未参加者が全リスト名を知れてしまい、5.3 に反する。
      allow get: if isVerified();
      allow list: if false;
      allow write: if false;
    }

    // -----------------------------------------------------------------
    // listRequests（リスト作成申請／5.1）
    // -----------------------------------------------------------------

    match /listRequests/{requestId} {
      allow read: if isSiteAdmin() ||
        (isVerified() && resource.data.requestedBy == uid());

      allow create: if isVerified()
        && request.resource.data.requestedBy == uid()
        && request.resource.data.status == 'pending';

      // 承認・却下は Functions が行う（13.3）。
      allow update, delete: if false;
    }

    // -----------------------------------------------------------------
    // shareLinks（共有リンク／3.3）
    // -----------------------------------------------------------------

    match /shareLinks/{linkId} {
      // ID を知っている人だけが到達できる。ID は推測できない値にする（13.3）。
      //
      // **期限が無いぶん、ID の推測されにくさがそのまま守りになる。**
      // 一覧は決して許さない。許すと、すべてのリンクを集められる。
      allow get: if isVerified();
      allow list: if false;

      // 発行・受け入れ・取消とも Functions のみ（13.3）。
      allow write: if false;
    }

    // -----------------------------------------------------------------
    // siteConfig（11.1）
    // -----------------------------------------------------------------

    // **internal はサーバーだけのもの。** 通知の宛先を集めるための
    // サイト管理者の uid 一覧や、定期削除の走査位置を置く。
    // 利用者に見せる必要が無いので、読み書きとも一切許可しない
    // （監査 第2回。以前は誰でも読める global に混ぜようとしていた）。
    // **ルールは「いずれかが許せば通る」。** internal を禁じる match を
    // 別に書いても、下の {docId} が許してしまうと読めてしまう。
    // 除外は許可する側の条件に書く。
    match /siteConfig/{docId} {
      allow read: if isVerified() && docId != 'internal';

      // siteAdminCount は Functions が持つ（4.5）。
      allow write: if isSiteAdmin()
        && docId != 'internal'
        && !request.resource.data.diff(resource.data)
             .affectedKeys().hasAny(['siteAdminCount']);
    }

    // -----------------------------------------------------------------
    // coupons（プレミアムのクーポン／PREMIUM-DESIGN 3.2・5）
    // -----------------------------------------------------------------
    //
    // **クライアントからは読みも書きも一切できない。**
    // 読めるとコードの一覧がそのまま漏れ、誰でもプレミアムになれる
    // （PREMIUM-DESIGN 9 の 3）。
    //
    // **サイト管理者も例外にしない。** 発行・一覧・上限の変更・停止・
    // 引き換えは、すべて呼び出し可能関数を通す。サーバー（Admin SDK）は
    // ルールを迂回するので、管理画面はそちらで動く。
    //
    // 下の {document=**} でも拒否されるが、**ここに明示して書く。**
    // 「書き忘れて拒否されている」のと「意図して禁じた」のは、あとから
    // 読んで区別が付かない。区別が付かないと、次の人が気軽に開ける。
    match /coupons/{couponId} {
      allow read, write: if false;

      // **使用記録（redemptions）も同じ。** 誰がいつ使ったかは追跡用で、
      // 見えると「まだ空きのあるコード」の当たりが付く。
      // 二重取りの判定は Functions のトランザクションの中だけで行う。
      match /{couponSubPath=**} {
        allow read, write: if false;
      }
    }

    // -----------------------------------------------------------------
    // 上記以外は一切許可しない
    // -----------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
